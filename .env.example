# SkyMediator Environment Configuration
# Copy this file to .env and fill in your keys

# Google Gemini API Key (Free tier key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# LLM Model Name
SKYMEDIATOR_LLM_MODEL=gemini-1.5-flash

# Hub Operational Parameters
SKYMEDIATOR_HUB_AIRPORT=VOBL
SKYMEDIATOR_HUB_IATA=BLR
SKYMEDIATOR_TIMEZONE=Asia/Kolkata

# DGCA Regulatory Norms (2019 baseline in force, or toggle to 2024 revised norms)
SKYMEDIATOR_FDTL_VERSION=2019

# Deliberation Constraints
SKYMEDIATOR_MAX_NEGOTIATION_ROUNDS=3
